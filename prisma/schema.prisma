generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  type          String    @default("user")
  avatarUrl     String    @default("https://cdn.pixabay.com/photo/2015/10/05/22/37/blank-profile-picture-973460_1280.png") @map("avatar_url")
  emailVerified DateTime? @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  isAway        Boolean   @default(false) @map("is_away")
  phone         String?

  workspaces         UserWorkspace[]
  channels           UserChannel[]
  messages           Message[]
  directMessages     DirectMessage[]  @relation("DirectMessageSender")
  directMessagesOne  DirectMessage[]  @relation("DirectMessageUserOne")
  directMessagesTwo  DirectMessage[]  @relation("DirectMessageUserTwo")
  ownedWorkspaces    Workspace[]      @relation("SuperAdmin")
  workspaceMembers   WorkspaceMember[]
  workspaceRegulators WorkspaceRegulator[]
  channelMembers     ChannelMember[]
  channelRegulators  ChannelRegulator[]
  createdChannels    Channel[]          @relation("ChannelCreator")

  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Workspace {
  id         String   @id @default(uuid())
  name       String
  slug       String
  inviteCode String   @unique @map("invite_code")
  imageUrl   String?  @map("image_url")
  superAdmin String   @map("super_admin")
  createdAt  DateTime @default(now()) @map("created_at")

  superAdminUser User           @relation("SuperAdmin", fields: [superAdmin], references: [id])
  members        WorkspaceMember[]
  regulators     WorkspaceRegulator[]
  channels       Channel[]
  userWorkspaces UserWorkspace[]
  messages       Message[]

  @@map("workspaces")
}

model Channel {
  id          String   @id @default(uuid())
  name        String
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace   Workspace          @relation(fields: [workspaceId], references: [id])
  user        User               @relation("ChannelCreator", fields: [userId], references: [id])
  members     ChannelMember[]
  regulators  ChannelRegulator[]
  messages    Message[]
  userChannels UserChannel[]

  @@map("channels")
}

model Message {
  id          String   @id @default(uuid())
  content     String?
  fileUrl     String?  @map("file_url")
  channelId   String   @map("channel_id")
  userId      String   @map("user_id")
  workspaceId String   @map("workspace_id")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  channel Channel @relation(fields: [channelId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@map("messages")
}

model DirectMessage {
  id        Int      @id @default(autoincrement())
  content   String?
  fileUrl   String?  @map("file_url")
  user      String
  userOne   String   @map("user_one")
  userTwo   String   @map("user_two")
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sender     User @relation("DirectMessageSender", fields: [user], references: [id])
  userOneRel User @relation("DirectMessageUserOne", fields: [userOne], references: [id])
  userTwoRel User @relation("DirectMessageUserTwo", fields: [userTwo], references: [id])

  @@map("direct_messages")
}

model UserWorkspace {
  userId      String   @map("user_id")
  workspaceId String   @map("workspace_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@id([userId, workspaceId])
  @@map("user_workspaces")
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  workspaceId String   @map("workspace_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([userId, workspaceId])
  @@map("workspace_members")
}

model WorkspaceRegulator {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  workspaceId String   @map("workspace_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([userId, workspaceId])
  @@map("workspace_regulators")
}

model ChannelMember {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  channelId String   @map("channel_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  channel Channel @relation(fields: [channelId], references: [id])

  @@unique([userId, channelId])
  @@map("channel_members")
}

model ChannelRegulator {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  channelId String   @map("channel_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  channel Channel @relation(fields: [channelId], references: [id])

  @@unique([userId, channelId])
  @@map("channel_regulators")
}

model UserChannel {
  userId    String   @map("user_id")
  channelId String   @map("channel_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  channel Channel @relation(fields: [channelId], references: [id])

  @@id([userId, channelId])
  @@map("user_channels")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")
  sessionState      String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
